# Set the currently running API/ops container (not the deletion worker).
# During Blue/Green deployment update this name to the active container.
PRIVACY_MONITOR_CONTAINER=REPLACE_WITH_ACTIVE_API_CONTAINER
PRIVACY_ALERT_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
# Must be an approved sender in the host's configured sendmail/msmtp transport.
PRIVACY_ALERT_FROM=REPLACE_WITH_APPROVED_SENDER
