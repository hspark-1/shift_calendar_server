# Server
PORT=3000
NODE_ENV=development
INSTANCE_NAME=shiftmate-api-1
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=https://shift-calendar.co.kr,http://localhost:3000
REQUEST_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Work shift monthly cache (enable only after DB migration and Redis provisioning)
WORK_SHIFT_CACHE_ENABLED=false
REDIS_URL=redis://:replace-with-redis-password@shiftmate_cache:6379
REDIS_PASSWORD=replace-with-redis-password
CACHE_KEY_PREFIX=shiftmate:development
WORK_SHIFT_CACHE_TTL_SECONDS=86400
WORK_SHIFT_CACHE_TTL_JITTER_SECONDS=3600
WORK_SHIFT_CACHE_LOCK_MS=5000
WORK_SHIFT_CACHE_WAIT_MS=500
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=100
CACHE_OUTBOX_POLL_MS=1000
CACHE_OUTBOX_BATCH_SIZE=100

# Database (PostgreSQL - AWS RDS)
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shift_calendar
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SSL=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Naver OAuth
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Apple OAuth (추후 사용)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY=your-apple-private-key
