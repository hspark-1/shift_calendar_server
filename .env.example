# Runtime
PORT=3000
NODE_ENV=development
INSTANCE_NAME=local-api
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30

# Profile image object storage (S3-compatible; API process only)
PROFILE_IMAGE_STORAGE_BUCKET=shiftmate-profile-images-local
PROFILE_IMAGE_STORAGE_REGION=ap-northeast-2
PROFILE_IMAGE_STORAGE_PREFIX=local
PROFILE_IMAGE_STORAGE_ENDPOINT=
PROFILE_IMAGE_STORAGE_FORCE_PATH_STYLE=false
PROFILE_IMAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3 호환 서비스가 static credential을 요구할 때만 설정. AWS workload role 사용 시 생략.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Work shift cache (disabled by default)
WORK_SHIFT_CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_KEY_PREFIX=shiftmate:local
WORK_SHIFT_CACHE_TTL_SECONDS=86400
WORK_SHIFT_CACHE_TTL_JITTER_SECONDS=3600
WORK_SHIFT_CACHE_LOCK_MS=5000
WORK_SHIFT_CACHE_WAIT_MS=250
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=500
CACHE_OUTBOX_POLL_MS=1000
CACHE_OUTBOX_BATCH_SIZE=100

# Push notifications (disabled by default)
PUSH_JOB_ENQUEUE_ENABLED=false
PUSH_WORKER_ENABLED=false
PUSH_APP_ENVIRONMENT=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PUSH_JOB_POLL_MS=1000
PUSH_JOB_BATCH_SIZE=20
PUSH_JOB_LEASE_SECONDS=120
PUSH_MAX_ATTEMPTS=6
PUSH_JOB_TTL_SECONDS=3600
PUSH_TERMINAL_RETENTION_DAYS=30

# Group
GROUP_MEMBER_LIMIT=20
GROUP_INVITATION_TTL_DAYS=7
GROUP_CALENDAR_MAX_RANGE_DAYS=100
API_DOCS_ENABLED=false

# PostgreSQL local example
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shift_calendar_local
DB_USER=postgres
DB_PASSWORD=change-me-local-only
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# ShiftMate JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Existing OAuth providers
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/test/callback.html
# API가 허용할 카카오 앱의 숫자형 App ID. Stage와 Production은 서로 다른 앱을 사용한다.
KAKAO_APP_ID=123456
# 회원 탈퇴 worker에만 mount하는 Admin Key Docker secret 경로.
KAKAO_ADMIN_KEY_FILE=/run/secrets/kakao_admin_key
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Google Sign-In (항상 활성화되므로 Web application OAuth client ID 필수)
GOOGLE_SERVER_CLIENT_ID=

# Sign in with Apple (항상 활성화되므로 환경별 key/client 설정 필수)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_IOS_CLIENT_ID=com.hspark.shiftmate
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
APPLE_PRIVATE_KEY_PATH=
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_CHALLENGE_TTL_SECONDS=300
APPLE_JWKS_CACHE_SECONDS=21600

# Account deletion (migration과 Stage E2E 전에는 두 flag 모두 false)
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false
ACCOUNT_DELETION_REAUTH_SECONDS=600
ACCOUNT_DELETION_POLL_MS=1000
ACCOUNT_DELETION_BATCH_SIZE=10
ACCOUNT_DELETION_LEASE_SECONDS=120
ACCOUNT_DELETION_MAX_ATTEMPTS=12
ACCOUNT_DELETION_RETENTION_DAYS=30
