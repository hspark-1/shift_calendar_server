{
  "tags": [
    {
      "name": "Profile",
      "description": "본인 가입 프로필 완료와 일반 프로필 조회·수정 API입니다."
    }
  ],
  "paths": {
    "/profile-images/{user_id}": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "인증된 비공개 프로필 이미지 조회",
        "description": "활성 로그인 사용자에게 활성 계정의 기본 아바타를 제공합니다. 서버가 S3를 읽어 바이트를 직접 전달하며 원본 URL, key, 서명 URL로 redirect하지 않습니다. private, no-store 및 Vary: Authorization 적용. 외부 OAuth 사진은 이 경로에서 fetch하지 않습니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "이미지 바이트",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProfileBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/ProfileUnauthorized"
          },
          "404": {
            "description": "활성 계정·관리 이미지·객체 없음 (PROFILE_IMAGE_NOT_FOUND)"
          },
          "409": {
            "description": "요청자 회원 탈퇴 진행 중"
          },
          "503": {
            "$ref": "#/components/responses/ProfileStorageUnavailable"
          }
        }
      }
    },
    "/auth/profile/complete": {
      "post": {
        "tags": ["Profile"],
        "summary": "가입 프로필 최초 완료",
        "description": "필수 프로필과 최초 완료 시각을 단일 DB transaction으로 저장합니다. 같은 값을 재전송해도 기존 완료 시각은 유지됩니다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileCompleteFields" }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/ProfileCompleteFields" },
                  {
                    "type": "object",
                    "properties": {
                      "profile_image": {
                        "type": "string",
                        "format": "binary",
                        "description": "JPEG, PNG, WebP 1개. MIME과 magic byte가 일치해야 하며 최대 5MB입니다."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "가입 프로필 완료 또는 멱등 재전송 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProfileBadRequest" },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" },
          "409": { "$ref": "#/components/responses/ProfilePhoneConflict" },
          "413": { "$ref": "#/components/responses/ProfileImageTooLarge" },
          "429": { "$ref": "#/components/responses/ProfileRateLimited" },
          "503": { "$ref": "#/components/responses/ProfileStorageUnavailable" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "내 프로필 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "본인 프로필",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" }
        }
      },
      "post": {
        "tags": ["Profile"],
        "summary": "일반 프로필 수정",
        "description": "생략한 필드는 유지합니다. profile_image_url은 현재 값 유지 또는 null/빈 문자열로 제거만 허용합니다. 파일 교체는 /auth/profile/complete의 multipart로 수행하며 최초 완료 시각은 보존합니다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProfileBadRequest" },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" },
          "409": { "$ref": "#/components/responses/ProfilePhoneConflict" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileCompleteFields": {
        "type": "object",
        "required": ["name", "timezone", "phone"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "timezone": { "type": "string", "example": "Asia/Seoul" },
          "phone": { "type": "string", "example": "01012345678" },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "minLength": 1, "maxLength": 100, "nullable": true }
        },
        "additionalProperties": false
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "timezone": { "type": "string" },
          "phone": { "type": "string" },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "maxLength": 100, "nullable": true },
          "profile_image_url": { "type": "string", "format": "uri", "maxLength": 2048, "nullable": true, "description": "현재 값 유지 또는 null/빈 문자열로 제거. 다른 URL로 교체는 INVALID_PROFILE_IMAGE로 거절합니다." }
        },
        "additionalProperties": false
      },
      "OwnProfile": {
        "type": "object",
        "required": ["user_id", "email", "name", "requires_profile_setup"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "timezone": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "nullable": true },
          "profile_image_url": { "type": "string", "format": "uri", "nullable": true, "description": "관리 이미지는 서버의 /api/v1/profile-images/{user_id} 주소입니다. Authorization: Bearer 헤더가 필요합니다. 외부 OAuth 이미지 주소는 유지합니다." },
          "requires_profile_setup": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "ProfileResponse": {
        "type": "object",
        "required": ["success", "data", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/OwnProfile" },
          "request_id": { "type": "string" }
        }
      },
      "ProfileErrorResponse": {
        "type": "object",
        "required": ["success", "error", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "INVALID_PHONE",
                  "INVALID_TIMEZONE",
                  "INVALID_JOB_TYPE",
                  "INVALID_PROFILE_IMAGE",
                  "PROFILE_IMAGE_TOO_LARGE",
                  "UNAUTHORIZED",
                  "PHONE_ALREADY_EXISTS",
                  "AUTH_RATE_LIMIT_EXCEEDED",
                  "PROFILE_IMAGE_STORAGE_UNAVAILABLE",
                  "PROFILE_IMAGE_NOT_FOUND"
                ]
              },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "ProfileBadRequest": {
        "description": "필수값, 길이, phone, timezone, job type 또는 이미지 검증 실패",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileUnauthorized": {
        "description": "유효한 ShiftMate access token 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfilePhoneConflict": {
        "description": "정규화된 전화번호를 다른 사용자가 사용 중",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileImageTooLarge": {
        "description": "프로필 이미지 5MB 초과",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileRateLimited": {
        "description": "인증 rate limit 초과",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileStorageUnavailable": {
        "description": "object storage 업로드 또는 조회 실패. 원본 AccessDenied/응답 본문은 노출하지 않습니다.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      }
    }
  }
}
