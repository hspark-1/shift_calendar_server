{
  "tags": [
    {
      "name": "Profile",
      "description": "본인 가입 프로필 완료와 일반 프로필 조회·수정 API입니다."
    }
  ],
  "paths": {
    "/auth/profile/complete": {
      "post": {
        "tags": ["Profile"],
        "summary": "가입 프로필 최초 완료",
        "description": "필수 프로필과 최초 완료 시각을 단일 DB transaction으로 저장합니다. 같은 값을 재전송해도 기존 완료 시각은 유지됩니다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileCompleteFields" }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/ProfileCompleteFields" },
                  {
                    "type": "object",
                    "properties": {
                      "profile_image": {
                        "type": "string",
                        "format": "binary",
                        "description": "JPEG, PNG, WebP 1개. MIME과 magic byte가 일치해야 하며 최대 5MB입니다."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "가입 프로필 완료 또는 멱등 재전송 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProfileBadRequest" },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" },
          "409": { "$ref": "#/components/responses/ProfilePhoneConflict" },
          "413": { "$ref": "#/components/responses/ProfileImageTooLarge" },
          "429": { "$ref": "#/components/responses/ProfileRateLimited" },
          "503": { "$ref": "#/components/responses/ProfileStorageUnavailable" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "내 프로필 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "본인 프로필",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" }
        }
      },
      "post": {
        "tags": ["Profile"],
        "summary": "일반 프로필 수정",
        "description": "생략한 필드는 유지합니다. job_type, workplace, profile_image_url의 명시적 null 또는 빈 문자열은 null로 저장합니다. 이 API는 profile_completed_at을 생성하지 않습니다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProfileBadRequest" },
          "401": { "$ref": "#/components/responses/ProfileUnauthorized" },
          "409": { "$ref": "#/components/responses/ProfilePhoneConflict" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileCompleteFields": {
        "type": "object",
        "required": ["name", "timezone", "phone"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "timezone": { "type": "string", "example": "Asia/Seoul" },
          "phone": { "type": "string", "example": "01012345678" },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "minLength": 1, "maxLength": 100, "nullable": true }
        },
        "additionalProperties": false
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "timezone": { "type": "string" },
          "phone": { "type": "string" },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "maxLength": 100, "nullable": true },
          "profile_image_url": { "type": "string", "format": "uri", "maxLength": 2048, "nullable": true }
        },
        "additionalProperties": false
      },
      "OwnProfile": {
        "type": "object",
        "required": ["user_id", "email", "name", "requires_profile_setup"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "timezone": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "job_type": {
            "type": "string",
            "enum": ["NURSE", "DOCTOR", "EMT", "OTHER"],
            "nullable": true
          },
          "workplace": { "type": "string", "nullable": true },
          "profile_image_url": { "type": "string", "format": "uri", "nullable": true },
          "requires_profile_setup": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "ProfileResponse": {
        "type": "object",
        "required": ["success", "data", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/OwnProfile" },
          "request_id": { "type": "string" }
        }
      },
      "ProfileErrorResponse": {
        "type": "object",
        "required": ["success", "error", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "INVALID_PHONE",
                  "INVALID_TIMEZONE",
                  "INVALID_JOB_TYPE",
                  "INVALID_PROFILE_IMAGE",
                  "PROFILE_IMAGE_TOO_LARGE",
                  "UNAUTHORIZED",
                  "PHONE_ALREADY_EXISTS",
                  "AUTH_RATE_LIMIT_EXCEEDED",
                  "PROFILE_IMAGE_STORAGE_UNAVAILABLE"
                ]
              },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "ProfileBadRequest": {
        "description": "필수값, 길이, phone, timezone, job type 또는 이미지 검증 실패",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileUnauthorized": {
        "description": "유효한 ShiftMate access token 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfilePhoneConflict": {
        "description": "정규화된 전화번호를 다른 사용자가 사용 중",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileImageTooLarge": {
        "description": "프로필 이미지 5MB 초과",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileRateLimited": {
        "description": "인증 rate limit 초과",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      },
      "ProfileStorageUnavailable": {
        "description": "object storage 업로드 실패",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileErrorResponse" } } }
      }
    }
  }
}
