{
  "openapi": "3.0.3",
  "info": {
    "title": "ShiftMate Group API",
    "version": "1.0.0",
    "description": "그룹 P0/P1 API와 공통 bearer/error/pagination 계약만 기술합니다. 기존 인증·친구·개인 캘린더 API는 이 문서 범위에 포함하지 않습니다."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Groups",
      "description": "활성 그룹 멤버 조회 및 역할 기반 관리"
    },
    {
      "name": "Group Invitations",
      "description": "친구 관계를 전제로 한 그룹 초대"
    }
  ],
  "paths": {
    "/groups": {
      "post": {
        "tags": ["Groups"],
        "summary": "그룹 생성",
        "description": "그룹, OWNER 멤버십, 초기 초대와 DB 알림을 하나의 transaction으로 생성합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGroupResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "get": {
        "tags": ["Groups"],
        "summary": "내 그룹 목록",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "required": ["groups", "pagination"],
                      "properties": {
                        "groups": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/GroupSummary"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/groups/{group_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupId"
        }
      ],
      "get": {
        "tags": ["Groups"],
        "summary": "그룹 상세",
        "responses": {
          "200": {
            "$ref": "#/components/responses/GroupDetailResponse"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "그룹 정보 수정",
        "description": "OWNER 또는 ADMIN 역할이 필요합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/GroupDetailResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Groups"],
        "summary": "그룹 soft-delete",
        "description": "OWNER 역할이 필요합니다.",
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "group_id": "2b1fdc0b-4240-4e6e-95f5-cdbed7530a2f",
                    "deleted_at": "2026-07-29T03:00:00.000Z"
                  },
                  "message": "그룹이 삭제되었습니다."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/groups/{group_id}/calendar/range": {
      "get": {
        "tags": ["Groups"],
        "summary": "그룹 캘린더 범위 조회",
        "description": "멤버 접근 상태, 근무, 이벤트를 고정 3개 SQL로 조회합니다. DENIED 멤버 데이터와 숨겨진 개수는 반환하지 않습니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/GroupId"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/GroupCalendarRange"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/groups/{group_id}/invitations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupId"
        }
      ],
      "post": {
        "tags": ["Group Invitations"],
        "summary": "그룹 초대 생성",
        "description": "OWNER 또는 ADMIN 역할이 필요하며 bulk 전체 성공/실패입니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "초대 생성 성공"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "get": {
        "tags": ["Group Invitations"],
        "summary": "그룹별 초대 목록",
        "description": "OWNER 또는 ADMIN 역할이 필요합니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationStatus"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InvitationListResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/group-invitations/received": {
      "get": {
        "tags": ["Group Invitations"],
        "summary": "받은 그룹 초대 목록",
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationStatus"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/InvitationListResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/group-invitations/{invitation_id}/respond": {
      "put": {
        "tags": ["Group Invitations"],
        "summary": "그룹 초대 수락/거절",
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["accept", "reject"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "응답 성공"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/group-invitations/{invitation_id}/cancel": {
      "put": {
        "tags": ["Group Invitations"],
        "summary": "그룹 초대 취소",
        "description": "초대 그룹의 OWNER 또는 ADMIN 역할이 필요합니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/InvitationId"
          }
        ],
        "responses": {
          "200": {
            "description": "취소 성공"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/groups/{group_id}/members/{user_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupId"
        },
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "delete": {
        "tags": ["Groups"],
        "summary": "그룹 멤버 제거",
        "description": "OWNER는 ADMIN/MEMBER, ADMIN은 MEMBER만 제거할 수 있습니다.",
        "responses": {
          "200": {
            "description": "제거 성공"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "그룹 멤버 역할 변경",
        "description": "OWNER 역할이 필요합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": ["ADMIN", "MEMBER"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/groups/{group_id}/leave": {
      "post": {
        "tags": ["Groups"],
        "summary": "그룹 나가기",
        "parameters": [
          {
            "$ref": "#/components/parameters/GroupId"
          }
        ],
        "responses": {
          "200": {
            "description": "나가기 성공"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/groups/{group_id}/owner": {
      "put": {
        "tags": ["Groups"],
        "summary": "그룹 소유권 이전",
        "description": "현재 OWNER 역할이 필요합니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/GroupId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["new_owner_user_id"],
                "properties": {
                  "new_owner_user_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/GroupDetailResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "GroupId": {
        "name": "group_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "InvitationId": {
        "name": "invitation_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "InvitationStatus": {
        "name": "status",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/GroupInvitationStatus"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "validation 실패",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INVALID_GROUP_NAME",
                "message": "그룹 이름은 trim 후 1~50자여야 합니다."
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "인증 실패",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "UNAUTHORIZED",
                "message": "로그인이 필요합니다."
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "활성 멤버이지만 역할 부족",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "GROUP_PERMISSION_DENIED",
                "message": "해당 그룹 작업 권한이 없습니다."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "그룹/멤버/초대 없음",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "GROUP_NOT_FOUND",
                "message": "그룹을 찾을 수 없습니다."
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "도메인 상태 충돌",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "GROUP_INVITATION_ALREADY_PENDING",
                "message": "이미 대기 중인 그룹 초대가 있습니다."
              }
            }
          }
        }
      },
      "GroupDetailResponse": {
        "description": "그룹 상세",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["success", "data"],
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "object",
                  "required": ["group"],
                  "properties": {
                    "group": {
                      "$ref": "#/components/schemas/GroupDetail"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "InvitationListResponse": {
        "description": "초대 목록",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["success", "data"],
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "type": "object",
                  "required": ["invitations", "pagination"],
                  "properties": {
                    "invitations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GroupInvitation"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "total_pages"],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "GroupRole": {
        "type": "string",
        "enum": ["OWNER", "ADMIN", "MEMBER"]
      },
      "GroupInvitationStatus": {
        "type": "string",
        "enum": ["PENDING", "ACCEPTED", "REJECTED", "CANCELED", "EXPIRED"]
      },
      "GroupUserSummary": {
        "type": "object",
        "required": ["user_id", "name", "profile_image_url"],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "profile_image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        }
      },
      "GroupMember": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GroupUserSummary"
          },
          {
            "type": "object",
            "required": ["role", "joined_at"],
            "properties": {
              "role": {
                "$ref": "#/components/schemas/GroupRole"
              },
              "joined_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "GroupSummary": {
        "type": "object",
        "required": [
          "group_id",
          "name",
          "timezone",
          "my_role",
          "member_count",
          "members_preview",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "my_role": {
            "$ref": "#/components/schemas/GroupRole"
          },
          "member_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "members_preview": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/GroupUserSummary"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GroupDetail": {
        "type": "object",
        "required": [
          "group_id",
          "name",
          "timezone",
          "my_role",
          "member_count",
          "members",
          "created_by_user_id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "timezone": {
            "type": "string"
          },
          "my_role": {
            "$ref": "#/components/schemas/GroupRole"
          },
          "member_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupMember"
            }
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateGroupRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "invitee_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "UpdateGroupRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          }
        }
      },
      "CreateInvitationsRequest": {
        "type": "object",
        "required": ["invitee_user_ids"],
        "properties": {
          "invitee_user_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "message": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          }
        }
      },
      "InvitationSummary": {
        "type": "object",
        "required": ["invitation_id", "invitee_user_id", "status", "expires_at"],
        "properties": {
          "invitation_id": {
            "type": "string",
            "format": "uuid"
          },
          "invitee_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/GroupInvitationStatus"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateGroupResponse": {
        "type": "object",
        "required": ["success", "data", "message"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "required": ["group", "invitations"],
            "properties": {
              "group": {
                "$ref": "#/components/schemas/GroupDetail"
              },
              "invitations": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InvitationSummary"
                }
              }
            }
          },
          "message": {
            "type": "string",
            "example": "그룹이 생성되었습니다."
          }
        }
      },
      "GroupInvitation": {
        "type": "object",
        "required": [
          "invitation_id",
          "group",
          "inviter",
          "invitee_user_id",
          "status",
          "message",
          "expires_at",
          "created_at",
          "responded_at"
        ],
        "properties": {
          "invitation_id": {
            "type": "string",
            "format": "uuid"
          },
          "group": {
            "type": "object",
            "required": ["group_id", "name", "member_count"],
            "properties": {
              "group_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "member_count": {
                "type": "integer"
              }
            }
          },
          "inviter": {
            "$ref": "#/components/schemas/GroupUserSummary"
          },
          "invitee_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/GroupInvitationStatus"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "responded_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "GroupCalendarRange": {
        "type": "object",
        "required": ["group", "range", "members", "work_shifts", "events"],
        "properties": {
          "group": {
            "type": "object",
            "required": ["group_id", "name", "timezone"],
            "properties": {
              "group_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            }
          },
          "range": {
            "type": "object",
            "required": ["start_date", "end_date"],
            "properties": {
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "end_date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "members": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/GroupMember"
                },
                {
                  "type": "object",
                  "required": ["calendar_access"],
                  "properties": {
                    "calendar_access": {
                      "type": "string",
                      "enum": ["SELF", "VISIBLE", "DENIED"]
                    }
                  }
                }
              ]
            }
          },
          "work_shifts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "owner_user_id",
                "work_shift_id",
                "work_date",
                "shift_type_code",
                "shift_type_name",
                "shift_type_color",
                "start_time",
                "end_time",
                "note",
                "created_at",
                "updated_at"
              ],
              "properties": {
                "owner_user_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "work_shift_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "work_date": {
                  "type": "string",
                  "format": "date"
                },
                "shift_type_code": {
                  "type": "string"
                },
                "shift_type_name": {
                  "type": "string"
                },
                "shift_type_color": {
                  "type": "string",
                  "pattern": "^#[0-9A-F]{8}$",
                  "nullable": true
                },
                "start_time": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "nullable": true
                },
                "end_time": {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                  "nullable": true
                },
                "note": {
                  "type": "string",
                  "nullable": true
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "owner_user_id",
                "event_id",
                "title",
                "memo",
                "place",
                "all_day",
                "start_at",
                "end_at",
                "visibility_level"
              ],
              "properties": {
                "owner_user_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "event_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "memo": {
                  "type": "string",
                  "nullable": true
                },
                "place": {
                  "type": "string",
                  "nullable": true
                },
                "all_day": {
                  "type": "boolean"
                },
                "start_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "end_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "visibility_level": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
