{
  "tags": [
    {
      "name": "Google Auth",
      "description": "항상 활성화되는 Google ID Token 서버 검증 로그인입니다."
    }
  ],
  "paths": {
    "/auth/google/token": {
      "post": {
        "tags": ["Google Auth"],
        "summary": "Google ID Token 검증 및 ShiftMate 로그인",
        "description": "Web application OAuth client ID 하나를 audience로 고정해 검증하며, 검증된 sub와 이메일 claim만 계정 판단에 사용합니다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GoogleLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "기존 Google 사용자 로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GoogleLoginResponse" }
              }
            }
          },
          "201": {
            "description": "신규 Google 사용자 회원가입 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GoogleLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/GoogleBadRequest" },
          "401": { "$ref": "#/components/responses/GoogleInvalidToken" },
          "409": { "$ref": "#/components/responses/GoogleAccountLinkRequired" },
          "429": { "$ref": "#/components/responses/GoogleRateLimited" },
          "500": { "$ref": "#/components/responses/GoogleInternalError" },
          "503": { "$ref": "#/components/responses/GoogleUnavailable" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GoogleLoginRequest": {
        "type": "object",
        "required": ["id_token"],
        "description": "추가 필드는 Google 신원 정보로 사용하지 않습니다.",
        "properties": {
          "id_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "writeOnly": true,
            "description": "Google SDK가 발급한 ID Token"
          }
        }
      },
      "GoogleUser": {
        "type": "object",
        "required": ["user_id", "email", "name", "google_id"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "profile_image_url": { "type": "string", "format": "uri", "nullable": true },
          "timezone": { "type": "string", "nullable": true },
          "google_id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "GoogleLoginResponse": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["user", "access_token", "refresh_token", "expires_at", "is_new_user"],
            "properties": {
              "user": { "$ref": "#/components/schemas/GoogleUser" },
              "access_token": { "type": "string", "writeOnly": true },
              "refresh_token": { "type": "string", "writeOnly": true },
              "expires_at": {
                "type": "integer",
                "format": "int64",
                "description": "Unix epoch milliseconds"
              },
              "is_new_user": { "type": "boolean" }
            }
          }
        }
      },
      "GoogleErrorResponse": {
        "type": "object",
        "required": ["success", "error", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "GOOGLE_INVALID_TOKEN",
                  "GOOGLE_EMAIL_UNAVAILABLE",
                  "ACCOUNT_LINK_REQUIRED",
                  "AUTH_RATE_LIMIT_EXCEEDED",
                  "GOOGLE_UPSTREAM_UNAVAILABLE",
                  "INTERNAL_SERVER_ERROR"
                ]
              },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "GoogleBadRequest": {
        "description": "요청 validation 또는 확인된 이메일 claim 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleInvalidToken": {
        "description": "Google ID Token 서명/audience/issuer/만료/필수 claim 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleAccountLinkRequired": {
        "description": "검증 이메일과 기존 계정 충돌. 자동 연결하지 않습니다.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleRateLimited": {
        "description": "인증 rate limit 초과",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleInternalError": {
        "description": "분류되지 않은 서버 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleUnavailable": {
        "description": "Google 공개키/검증 upstream 장애",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      }
    }
  }
}
