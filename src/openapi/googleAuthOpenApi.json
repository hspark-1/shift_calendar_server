{
  "tags": [
    {
      "name": "Google Auth",
      "description": "항상 활성화되는 Google ID Token 서버 검증 로그인입니다."
    }
  ],
  "paths": {
    "/auth/google/token": {
      "post": {
        "tags": ["Google Auth"],
        "summary": "Google ID Token 검증 및 ShiftMate 로그인",
        "description": "Web application OAuth client ID 하나를 audience로 고정해 검증하며, 검증된 sub와 이메일 claim만 계정 판단에 사용합니다. 선택 access_token으로 동일 계정 전화번호를 조회해 신규/빈 phone만 저장합니다. 사진 claim은 읽거나 저장하지 않습니다. 가입 완료 상태는 변경하지 않습니다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GoogleLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "기존 Google 사용자 로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GoogleLoginResponse" }
              }
            }
          },
          "201": {
            "description": "신규 Google 사용자 회원가입 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GoogleLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/GoogleBadRequest" },
          "401": { "$ref": "#/components/responses/GoogleInvalidToken" },
          "409": { "$ref": "#/components/responses/GoogleAccountLinkRequired" },
          "429": { "$ref": "#/components/responses/GoogleRateLimited" },
          "500": { "$ref": "#/components/responses/GoogleInternalError" },
          "503": { "$ref": "#/components/responses/GoogleUnavailable" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GoogleLoginRequest": {
        "type": "object",
        "required": ["id_token"],
        "description": "ID Token으로 인증합니다. 선택 access_token은 동일 Google 계정을 대조한 뒤 전화번호만 조회하며 저장하지 않습니다. 요청 body의 phone/picture는 신뢰하지 않습니다.",
        "properties": {
          "id_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "writeOnly": true,
            "description": "Google SDK가 발급한 ID Token"
          },
          "access_token": {"type": "string", "minLength": 1, "maxLength": 16384, "writeOnly": true, "description": "선택. user.phonenumbers.read 권한을 받은 Google access token. 미전달/조회 불가 시 기존 직접 입력을 유지합니다. ID Token과 다른 계정이면 401입니다."}
        }
      },
      "GoogleUser": {
        "type": "object",
        "required": ["user_id", "email", "name", "google_id"],
        "properties": {
          "user_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "profile_image_url": {"type": "string", "format": "uri", "nullable": true, "description": "신규 Google 사진은 수집하지 않습니다. 기존 또는 사용자가 업로드한 사진은 유지합니다."},
          "phone": {"type": "string", "nullable": true, "description": "국내 하이픈 형식. 신규/기존 빈 번호만 Google 제공 번호로 보완합니다."},
          "timezone": { "type": "string", "nullable": true },
          "google_id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "GoogleLoginResponse": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["user", "access_token", "refresh_token", "expires_at", "is_new_user", "requires_profile_setup"],
            "properties": {
              "user": { "$ref": "#/components/schemas/GoogleUser" },
              "access_token": { "type": "string", "writeOnly": true },
              "refresh_token": { "type": "string", "writeOnly": true },
              "expires_at": {
                "type": "integer",
                "format": "int64",
                "description": "Unix epoch milliseconds"
              },
              "is_new_user": { "type": "boolean" },
              "requires_profile_setup": { "type": "boolean" }
            }
          }
        }
      },
      "GoogleErrorResponse": {
        "type": "object",
        "required": ["success", "error", "request_id"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "GOOGLE_INVALID_TOKEN",
                  "GOOGLE_EMAIL_UNAVAILABLE",
                  "ACCOUNT_LINK_REQUIRED",
                  "AUTH_RATE_LIMIT_EXCEEDED",
                  "GOOGLE_UPSTREAM_UNAVAILABLE",
                  "INTERNAL_SERVER_ERROR",
                  "PHONE_ALREADY_EXISTS",
                  "ACCOUNT_DELETION_IN_PROGRESS"
                ]
              },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "GoogleBadRequest": {
        "description": "요청 validation 또는 확인된 이메일 claim 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleInvalidToken": {
        "description": "Google ID Token 서명/audience/issuer/만료/필수 claim 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleAccountLinkRequired": {
        "description": "검증 이메일 충돌(ACCOUNT_LINK_REQUIRED), 전화번호 중복(PHONE_ALREADY_EXISTS), 탈퇴 진행(ACCOUNT_DELETION_IN_PROGRESS). 자동 계정 연결은 하지 않습니다.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleRateLimited": {
        "description": "인증 rate limit 초과",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleInternalError": {
        "description": "분류되지 않은 서버 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      },
      "GoogleUnavailable": {
        "description": "Google 공개키/검증 upstream 장애",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GoogleErrorResponse" }
          }
        }
      }
    }
  }
}
