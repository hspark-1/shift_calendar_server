{
  "tags": [
    {
      "name": "Calendar",
      "description": "개인 캘린더 일정 API"
    }
  ],
  "paths": {
    "/events/{event_id}": {
      "delete": {
        "tags": [
          "Calendar"
        ],
        "summary": "개인 일정 삭제",
        "description": "인증 사용자가 소유한 활성 개인 일정 1건을 soft delete합니다. 미존재, 타인 소유, 이미 삭제된 일정은 모두 EVENT_NOT_FOUND로 응답합니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "description": "삭제할 개인 일정 UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "일정 삭제 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDeleteSuccess"
                },
                "example": {
                  "success": true,
                  "data": {
                    "event_id": "2f0d8f41-4589-4f70-8d1f-fbf3fc274f98"
                  },
                  "message": "일정이 삭제되었습니다."
                }
              }
            }
          },
          "400": {
            "description": "event_id UUID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDeleteError"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_EVENT_ID",
                    "message": "일정 ID가 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDeleteError"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "로그인이 필요합니다."
                  }
                }
              }
            }
          },
          "404": {
            "description": "미존재, 타인 소유 또는 이미 삭제된 일정",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDeleteError"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "EVENT_NOT_FOUND",
                    "message": "일정을 찾을 수 없습니다."
                  }
                }
              }
            }
          },
          "500": {
            "description": "예상하지 못한 서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDeleteError"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "서버 오류가 발생했습니다."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "tags": [
          "Calendar"
        ],
        "summary": "개인 일정 생성",
        "description": "JWT 사용자를 소유자/생성자로 저장한다. is_private 생략은 false. 실제 JSON boolean만 허용하며 null·문자열·숫자·배열·객체는 INVALID_EVENT_PRIVACY(400). private여도 visibility_level 필수 0~5를 유지한다. place/memo는 trim 후 빈 값을 null로 저장한다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventInput"
              },
              "example": {
                "title": "개인 약속",
                "all_day": false,
                "start_at": "2026-11-11T00:00:00.000Z",
                "end_at": "2026-11-11T01:00:00.000Z",
                "visibility_level": 0,
                "is_private": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "일정 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCreateSuccess"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_TITLE / INVALID_EVENT_TIME / INVALID_VISIBILITY_LEVEL / INVALID_EVENT_PRIVACY / VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_EVENT_PRIVACY",
                    "message": "공개 범위가 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Calendar"
        ],
        "summary": "본인 일정 기간 조회",
        "description": "본인 활성 일정은 is_private=true도 포함하며 응답에 is_private를 반환한다. 조회 기간과 겹치는 일정을 반환한다. 날짜 범위 양끝을 포함한다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "events"
                      ],
                      "properties": {
                        "events": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/EventApiModel"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 검증 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/range": {
      "get": {
        "tags": [
          "Calendar"
        ],
        "summary": "본인 캘린더 기간 조회",
        "description": "본인 활성 일정은 is_private=true도 포함하며 응답에 is_private를 반환한다. 조회 기간과 겹치는 일정을 반환한다. 날짜 범위 양끝을 포함한다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "events",
                        "work_shifts"
                      ],
                      "properties": {
                        "events": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/EventApiModel"
                          }
                        },
                        "work_shifts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CalendarWorkShift"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 검증 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/day": {
      "get": {
        "tags": [
          "Calendar"
        ],
        "summary": "본인 날짜별 일정 조회",
        "description": "본인 활성 일정은 is_private=true도 포함하며 응답에 is_private를 반환한다. 해당 날짜에 시작하는 일정만 조회하는 기존 의미를 유지한다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "events",
                        "work_shifts",
                        "date"
                      ],
                      "properties": {
                        "events": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/EventApiModel"
                          }
                        },
                        "work_shifts": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "work_shift_id",
                              "work_date",
                              "shift_type_code",
                              "shift_type_name",
                              "shift_type_color",
                              "start_time",
                              "end_time",
                              "note"
                            ],
                            "properties": {
                              "work_shift_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "work_date": {
                                "type": "string",
                                "format": "date"
                              },
                              "shift_type_code": {
                                "type": "string"
                              },
                              "shift_type_name": {
                                "type": "string"
                              },
                              "shift_type_color": {
                                "type": "string",
                                "pattern": "^#[0-9A-F]{8}$",
                                "nullable": true
                              },
                              "start_time": {
                                "type": "string",
                                "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                                "nullable": true
                              },
                              "end_time": {
                                "type": "string",
                                "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
                                "nullable": true
                              },
                              "note": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          }
                        },
                        "date": {
                          "type": "string",
                          "format": "date"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 검증 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          }
        }
      }
    },
    "/friends/{friend_user_id}/calendar/range": {
      "get": {
        "tags": [
          "Calendar"
        ],
        "summary": "친구 캘린더 기간 조회",
        "description": "타인 private 행 전체를 제외한다. 친구 관계·owner→viewer can_view=true·friend_level>=visibility_level가 모두 필요하다. 공개 행은 is_private=false를 반환한다. 조회 기간과 겹치는 일정을 반환한다. 날짜 범위 양끝을 포함한다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "friend_user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "events",
                        "work_shifts"
                      ],
                      "properties": {
                        "events": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FriendCalendarEvent"
                          }
                        },
                        "work_shifts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CalendarWorkShift"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 검증 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "403": {
            "description": "CALENDAR_ACCESS_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          },
          "404": {
            "description": "FRIEND_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventDeleteSuccess": {
        "type": "object",
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "event_id"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "EventDeleteError": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_EVENT_ID",
                  "UNAUTHORIZED",
                  "EVENT_NOT_FOUND",
                  "INTERNAL_SERVER_ERROR"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "EventApiModel": {
        "type": "object",
        "required": [
          "event_id",
          "title",
          "memo",
          "place",
          "all_day",
          "start_at",
          "end_at",
          "visibility_level",
          "is_private",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "all_day": {
            "type": "boolean"
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "is_private": {
            "type": "boolean",
            "description": "true이면 소유자만 조회 가능. 친구 레벨·can_view·그룹 가입보다 우선한다."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FriendCalendarEvent": {
        "type": "object",
        "required": [
          "event_id",
          "title",
          "memo",
          "place",
          "all_day",
          "start_at",
          "end_at",
          "visibility_level",
          "is_private"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "all_day": {
            "type": "boolean"
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "is_private": {
            "type": "boolean",
            "description": "true이면 소유자만 조회 가능. 친구 레벨·can_view·그룹 가입보다 우선한다.",
            "enum": [
              false
            ]
          }
        }
      },
      "CreateEventInput": {
        "type": "object",
        "required": [
          "title",
          "all_day",
          "start_at",
          "end_at",
          "visibility_level"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "all_day": {
            "type": "boolean"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 Z 형식"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 Z 형식. start_at보다 이후인 배타적 종료"
          },
          "visibility_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "is_private": {
            "type": "boolean",
            "description": "true이면 소유자만 조회 가능. 친구 레벨·can_view·그룹 가입보다 우선한다.",
